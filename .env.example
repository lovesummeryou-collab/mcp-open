# 参考环境变量。本项目不自动加载 .env，请将需要的变量写入当前 shell。
MCPOPEN_HOST=0.0.0.0
MCPOPEN_PORT=8765
MCPOPEN_ADMIN_USER=admin
MCPOPEN_ADMIN_PASSWORD=请修改为强密码
MCPOPEN_SECRET_KEY=请修改为随机长字符串
MCPOPEN_SERVER_NAME=mcp-open
MCPOPEN_TIMEOUT=30
MCPOPEN_AUTH_AUTHORIZER=
MCPOPEN_CORS_ORIGINS=*
MCPOPEN_DEBUG=false
MCPOPEN_SQLITE_JOURNAL=auto
